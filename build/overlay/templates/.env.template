# SentinelCore release environment template.
# The installer fills the placeholder values. NO real secret ever lives in
# this file — generated secrets are written to the deployed .env only.

# --- Database ---
POSTGRES_USER=sentinelcore
POSTGRES_PASSWORD=__GENERATED__
POSTGRES_DB=sentinelcore
# Container services override this via compose; host tooling only.
DATABASE_URL=postgresql+asyncpg://sentinelcore:__GENERATED__@localhost:5433/sentinelcore

# --- Auth ---
# openssl rand -hex 32
SECRET_KEY=__GENERATED__
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- Bootstrap admin ---
# The installer seeds the admin ONCE, before the first normal backend start,
# with the operator's chosen (or installer-generated) password, passed via the
# process environment of a one-shot `docker compose run` — never written here.
# On later boots the app's seed step finds the admin and does nothing.
SEED_ADMIN_USERNAME=__ADMIN_USERNAME__
SEED_ADMIN_EMAIL=__ADMIN_EMAIL__

# --- Network scope (installer-detected, operator-confirmed) ---
CAPTURE_INTERFACE=__CAPTURE_INTERFACE__
MONITORED_NETWORK=__MONITORED_NETWORK__
# Gateway, DNS and self — may NEVER be firewall-blocked (M10)
PROTECTED_IPS=__PROTECTED_IPS__

# --- Web UI (nginx publish address; also used by the installer's checks) ---
# TLS_MODE: self-signed (default) | custom (operator cert) | http-local (127.0.0.1 only)
TLS_MODE=__TLS_MODE__
BIND_ADDRESS=__BIND_ADDRESS__
# HTTP_PORT redirects to HTTPS when TLS is on; it serves the UI only for http-local.
HTTP_PORT=__HTTP_PORT__
HTTPS_PORT=__HTTPS_PORT__
# Containers' timezone (report timestamps use it; the backend image ships tzdata).
TZ=__TIMEZONE__

# --- Suricata ---
SURICATA_EVE_LOG=/var/log/suricata/eve.json

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Pipeline ---
EVENT_RETENTION_DAYS=90

# production hides /api/docs and marks the refresh cookie Secure. The UI is
# served over HTTPS (or plain HTTP on 127.0.0.1 only), so login refresh works.
ENVIRONMENT=production

# --- Email (routed through the SentinelCore relay; NO Brevo key on the box) ---
# When EMAIL_MODE=brevo the installer adds docker-compose.email.yml (relay-shim
# + CA bundle via SSL_CERT_FILE on backend/worker). Off = none of that exists.
# off | dry_run | brevo  (brevo = via relay shim; see docs)
EMAIL_MODE=__EMAIL_MODE__
# Central SentinelCore relay (product-level, fixed per release build).
RELAY_URL=__RELAY_URL__
# Public per-install id at the relay (not a secret).
RELAY_INSTALL_ID=__RELAY_INSTALL_ID__
# This is a per-install RELAY token, NOT a Brevo key. The real Brevo key never
# leaves SentinelCore infrastructure.
BREVO_API_KEY=__RELAY_TOKEN__
EMAIL_SENDER_ADDRESS=__SENDER_ADDRESS__
EMAIL_SENDER_NAME=SentinelCore
EMAIL_REPLY_TO=
APP_BASE_URL=__APP_BASE_URL__
EMAIL_ALLOWED_RECIPIENT_DOMAINS=
EMAIL_DAILY_CAP_PER_RECIPIENT=50
EMAIL_GLOBAL_DAILY_CAP=250
EMAIL_MAX_ATTACHMENT_MB=5
BREVO_WEBHOOK_SECRET=__GENERATED__

