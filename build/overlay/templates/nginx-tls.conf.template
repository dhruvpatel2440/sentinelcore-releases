# SentinelCore release nginx — HTTPS (TLS_MODE=self-signed|custom).
# Rendered by the installer: __HTTPS_REDIRECT_SUFFIX__ (":<port>" or empty),
# __HSTS_LINE__ (only for a trusted, operator-supplied certificate).
# Port 80 only redirects. /api/ keeps its prefix (no trailing slash on
# proxy_pass) so the refresh cookie's Path=/api/auth matches.

limit_req_zone $binary_remote_addr zone=sc_login:10m rate=30r/m;

upstream backend_upstream {
    server backend:8000;
}

server {
    listen 80;
    server_name _;
    location = /nginx-health { access_log off; return 200 "ok\n"; }
    location / { return 301 https://$host__HTTPS_REDIRECT_SUFFIX__$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:sc_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    server_tokens off;

    # Security headers (server level; no add_header inside locations so these
    # are always inherited).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
__HSTS_LINE__

    root /usr/share/nginx/html;
    index index.html;

    # Main's default; uploads have their own larger limit below.
    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Defense in depth only; main's own per-user+IP lockout stays authoritative.
    location = /api/auth/login {
        limit_req zone=sc_login burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # M11 PCAP upload: the backend enforces max_pcap_size_mb=500 while
    # streaming (clean JSON 413). nginx allows a little multipart overhead and
    # streams the body straight through (no 500 MB temp file in nginx).
    location = /api/pcap/upload {
        client_max_body_size 501m;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        error_page 413 = @upload_too_large;
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location @upload_too_large {
        default_type application/json;
        return 413 '{"detail":"capture exceeds the 500MB limit"}';
    }

    location /assets/ {
        expires 30d;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
