---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Badge from "../components/Badge.astro";
import release from "../data/release.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const p = (h) => `${base}${h}`;
---
<Layout title="SentinelCore" path="/">
  <!-- Hero -->
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">Network detection &amp; incident response</p>
      <h1 class="hero-title"><span>See the attack.</span> <span class="hl">Contain it.</span> <span>Explain it.</span></h1>
      <p class="lead">
        Suricata watches a mirrored link, a rule-based pipeline turns raw alerts into
        deduplicated events and correlated incidents, and an analyst triages, contains,
        and reports — with <strong>no ML in the detection path</strong>, so every alert
        traces back to a signature or rule you can read.
      </p>
      <div class="cta-row">
        <Button href={p("/download/")} size="lg">⬇ Download SentinelCore</Button>
        <Button href={p("/how-it-works/")} size="lg" variant="secondary">How it works</Button>
      </div>
      <p class="muted small">
        v{release.version} · Linux only (Ubuntu 22.04 / 24.04) · one <code>docker compose up</code> · no telemetry
      </p>
    </div>
  </section>

  <!-- What it is -->
  <section class="section">
    <div class="container grid grid-3">
      <Card title="One host, one command" icon="▦">
        Deploys as a single Docker Compose stack on one Ubuntu host with a mirrored
        capture interface. No separate sensor infrastructure to stand up.
      </Card>
      <Card title="Auditable by design" icon="🔎">
        Rule-based detection only. Every incident links to the Suricata signature or
        correlation rule that produced it — nothing is a black box.
      </Card>
      <Card title="Privilege-separated" icon="🛡">
        The API holds no raw-socket power. Every privileged action crosses a single
        Unix socket to one capability-scoped helper container.
      </Card>
    </div>
  </section>

  <!-- Features -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">What's inside</p>
      <h2>From packet to incident to report</h2>
      <div class="grid grid-3" style="margin-top:1.5rem">
        <Card title="Passive IDS sensor">Suricata on af-packet, EVE JSON tailed into a deduplicating event pipeline.</Card>
        <Card title="Correlation → incidents">Related events are grouped by correlation rules and promoted to triageable incidents.</Card>
        <Card title="Containment with a TTL">Firewall blocks are applied through the helper with a mandatory expiry — never a permanent footgun.</Card>
        <Card title="Asset discovery">nmap + ARP sweeps map the monitored network, all behind the privilege boundary.</Card>
        <Card title="PCAP analysis">Upload captures for offline, unprivileged tshark parsing into flows and artifacts.</Card>
        <Card title="Reporting &amp; email">PDF reports and optional notifications routed through a central relay — no mail keys on your box.</Card>
      </div>
      <p style="margin-top:1.5rem"><Button href={p("/features/")} variant="secondary">See all capabilities →</Button></p>
    </div>
  </section>

  <!-- How it works flow -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2>Three inputs, one privilege boundary</h2>
      <div class="flow glass" role="img" aria-label="Browser to nginx to API and worker; API reaches the privileged helper over a Unix socket; Suricata feeds the event pipeline into incidents.">
        <div class="flow-row">
          <span class="node">Browser</span><span class="arrow">→</span>
          <span class="node">nginx :80</span><span class="arrow">→</span>
          <span class="node accent">FastAPI</span>
        </div>
        <div class="flow-row">
          <span class="node accent">FastAPI / worker</span><span class="arrow">→ unix socket →</span>
          <span class="node danger">privileged-helper</span><span class="arrow">→</span>
          <span class="node">nmap · iptables · Suricata</span>
        </div>
        <div class="flow-row">
          <span class="node">Suricata</span><span class="arrow">→ EVE →</span>
          <span class="node">pipeline</span><span class="arrow">→</span>
          <span class="node">events</span><span class="arrow">→</span>
          <span class="node accent">incidents</span>
        </div>
      </div>
      <p style="margin-top:1rem"><Button href={p("/how-it-works/")} variant="secondary">See the full architecture →</Button></p>
    </div>
  </section>

  <!-- Trust -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">Trust &amp; security</p>
      <h2>What stays on your box</h2>
      <div class="grid grid-2" style="margin-top:1.5rem">
        <Card title="Everything runs locally">
          The only outbound dependency is the optional email relay over HTTPS. Your
          traffic, captures, events and reports never leave the host.
        </Card>
        <Card title="No secrets shipped">
          Installs generate their own secrets. Email flows through a central relay that
          holds the provider key — your box only gets a revocable per-install token.
          <p style="margin-top:0.6rem"><Badge tone="ok">No telemetry</Badge> <Badge tone="mint">Local-first</Badge></p>
        </Card>
      </div>
      <div class="final-cta glass">
        <div>
          <h2 style="margin-bottom:0.3rem">Ready to deploy?</h2>
          <p class="muted" style="margin:0">One ZIP, a guided installer, and a mirrored NIC.</p>
        </div>
        <Button href={p("/download/")} size="lg">⬇ Download SentinelCore</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-top: clamp(3.5rem, 10vw, 7rem); padding-bottom: clamp(3rem, 8vw, 5rem); }
  .hero-title { font-size: clamp(2.8rem, 9vw, 5.4rem); line-height: 0.98; margin-bottom: 1.6rem; }
  .hero-title span { display: block; }
  .hl { color: rgb(var(--c-red)); }
  .hero .lead { font-size: clamp(1.02rem, 1.6vw, 1.18rem); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 1rem; margin: 2rem 0 1.2rem; }
  .small { font-size: 0.82rem; letter-spacing: 0.04em; text-transform: uppercase; color: rgb(var(--text-dim)); font-weight: 600; }
  .small code { text-transform: none; letter-spacing: 0; }
  .flow {
    position: relative; padding: 1.6rem; margin-top: 1.75rem; display: grid; gap: 1.1rem;
    background: rgb(var(--bg-solid)); border: 1px solid rgb(var(--glass-border)); border-radius: var(--r-md);
    border-right: 4px solid rgb(var(--c-red));
  }
  .flow-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .node {
    font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700;
    padding: 0.42rem 0.75rem; background: rgb(var(--bg-raised)); color: rgb(var(--text));
    border: 1px solid rgb(var(--outline)); border-radius: 6px;
  }
  .node.accent { background: rgb(var(--c-red) / 0.14); border-color: rgb(var(--c-red) / 0.7); color: #fff; }
  .node.danger { background: rgb(var(--c-red)); border-color: rgb(var(--c-red)); color: #fff; box-shadow: 3px 3px 0 0 rgb(var(--c-red-deep)); }
  .arrow { color: rgb(var(--text-dim)); font-family: var(--font-mono); font-size: 0.82rem; }
  .final-cta {
    margin-top: 3rem; padding: clamp(1.5rem, 4vw, 2.4rem); display: flex; flex-wrap: wrap; gap: 1.25rem;
    align-items: center; justify-content: space-between;
    background: rgb(var(--bg-solid)); border: 1px solid rgb(255 255 255 / 0.7); border-radius: var(--r-md);
    border-right: 6px solid rgb(var(--c-red));
  }
</style>
