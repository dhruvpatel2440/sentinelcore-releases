---
import Button from "./Button.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const p = (href) => `${base}${href}`;
const links = [
  ["/features/", "Features"],
  ["/how-it-works/", "How it works"],
  ["/security/", "Security"],
  ["/docs/", "Docs"],
  ["/requirements/", "Requirements"],
];
const current = Astro.url.pathname;
---
<header class="nav">
  <div class="container nav-inner">
    <a href={p("/")} class="brand" aria-label="SentinelCore home">
      <span class="brand-mark" aria-hidden="true">◆</span> SentinelCore
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Toggle menu">☰</button>
    <nav id="nav-menu" class="nav-menu" aria-label="Primary">
      {links.map(([href, label]) => (
        <a href={p(href)} aria-current={current.startsWith(p(href)) ? "page" : undefined}>{label}</a>
      ))}
      <Button href={p("/download/")} size="sm">Download</Button>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgb(10 10 10 / 0.82); border-bottom: 1px solid rgb(var(--hairline));
  }
  @supports (backdrop-filter: blur(1px)) { .nav { -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); } }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.85rem; }
  .brand {
    font-weight: 800; font-size: 1.12rem; letter-spacing: -0.01em; color: rgb(var(--text));
    text-decoration: none; display: inline-flex; gap: 0.6rem; align-items: center;
  }
  .brand:hover { text-decoration: none; }
  .brand-mark {
    width: 1.9rem; height: 1.9rem; display: grid; place-items: center; font-size: 0.9rem;
    color: #fff; background: rgb(var(--c-red)); border-radius: 6px; box-shadow: 3px 3px 0 0 rgb(var(--c-red-deep));
  }
  .nav-menu { display: flex; align-items: center; gap: 1.6rem; }
  .nav-menu a:not(.btn) {
    color: rgb(var(--text-muted)); text-decoration: none; font-weight: 600; font-size: 0.95rem;
    transition: color 120ms ease;
  }
  .nav-menu a:not(.btn):hover { color: rgb(var(--text)); }
  .nav-menu a[aria-current="page"] { color: rgb(var(--text)); box-shadow: inset 0 -2px 0 rgb(var(--c-red)); padding-bottom: 2px; }
  .nav-toggle {
    display: none; width: 2.6rem; height: 2.6rem; place-items: center; cursor: pointer;
    font-size: 1.2rem; color: #fff; background: rgb(var(--bg-raised));
    border: 1px solid rgb(var(--outline)); border-radius: var(--r-md); box-shadow: var(--shadow-sm);
  }
  .nav-toggle:active { transform: translate(4px, 4px); box-shadow: none; }
  @media (max-width: 820px) {
    .nav-toggle { display: grid; }
    .nav-menu {
      position: absolute; inset: 100% 0 auto 0; flex-direction: column; align-items: stretch;
      gap: 0.2rem; padding: 1rem 16px 1.25rem; background: rgb(var(--bg-page));
      border-bottom: 1px solid rgb(var(--hairline)); display: none;
    }
    .nav-menu a:not(.btn) { padding: 0.6rem 0; font-size: 1.05rem; text-transform: uppercase; font-weight: 800; color: rgb(var(--text)); }
    .nav-menu a[aria-current="page"] { color: rgb(var(--c-red-bright)); box-shadow: none; }
    .nav-menu.open { display: flex; }
  }
</style>

<script>
  const btn = document.querySelector(".nav-toggle");
  const menu = document.getElementById("nav-menu");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("open");
    btn.setAttribute("aria-expanded", String(!!open));
  });
</script>
