---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const p = (href) => `${base}${href}`;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="brand"><span class="brand-mark" aria-hidden="true">◆</span> SentinelCore</p>
      <p class="muted">Network detection &amp; incident response. Linux-only, runs locally.</p>
    </div>
    <div>
      <p class="footer-head">Navigation</p>
      <nav class="footer-links" aria-label="Footer">
        <a href={p("/features/")}>Features</a>
        <a href={p("/how-it-works/")}>How it works</a>
        <a href={p("/security/")}>Security</a>
        <a href={p("/docs/")}>Docs</a>
        <a href={p("/requirements/")}>Requirements</a>
        <a href={p("/download/")}>Download</a>
        <a href={p("/legal/")}>Legal &amp; privacy</a>
      </nav>
    </div>
  </div>
  <div class="container footer-bottom"><p class="small">© {year} SentinelCore · No telemetry · No trackers</p></div>
</footer>

<style>
  .footer { margin-top: 4rem; padding-block: 3.5rem 1.5rem; background: #050505; border-top: 1px solid rgb(var(--hairline)); }
  .footer-inner { display: grid; gap: 2.5rem; }
  @media (min-width: 720px) { .footer-inner { grid-template-columns: 1.2fr 1fr; } }
  .footer-brand .muted { max-width: 34ch; }
  .brand { font-weight: 800; font-size: 1.15rem; margin-bottom: 0.8rem; display: inline-flex; gap: 0.6rem; align-items: center; }
  .brand-mark {
    width: 2.4rem; height: 2.4rem; display: grid; place-items: center; font-size: 1rem; color: #fff;
    background: rgb(var(--c-red)); border-radius: 8px; box-shadow: 3px 3px 0 0 rgb(var(--c-red-deep));
  }
  .footer-head { font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 1rem; }
  .footer-links { display: grid; grid-template-columns: repeat(2, minmax(0, max-content)); gap: 0.65rem 3rem; }
  .footer-links a { color: rgb(var(--text-muted)); text-decoration: none; transition: color 120ms ease; }
  .footer-links a:hover { color: #fff; }
  .footer-bottom { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid rgb(var(--hairline)); }
  .small { font-size: 0.85rem; margin: 0; color: rgb(var(--text-dim)); }
</style>
