# Relay SERVER environment. Placeholders only — fill on the owner's host.
# NEVER commit real values. These live only on the relay server.

# Storage
RELAY_DB_PATH=/data/relay.db

# Admin API secret (protects /v1/revoke and /v1/admin/installs). REQUIRED.
# openssl rand -hex 32
RELAY_ADMIN_SECRET=__SET_ME__

# Provider: fake | brevo
RELAY_PROVIDER=brevo
# Real provider key — ONLY here, on the server. Never shipped to installs.
BREVO_API_KEY=__SET_ME__
RELAY_FROM_ADDRESS=notify@yourdomain.example
RELAY_FROM_NAME=SentinelCore

# Public URL (used to build verification links)
RELAY_PUBLIC_URL=https://relay.yourdomain.example

# Limits
RELAY_REGISTER_RATE_PER_IP_HOUR=5
RELAY_SEND_RATE_PER_TOKEN_MIN=30
RELAY_DAILY_QUOTA_PER_TOKEN=250
RELAY_GLOBAL_DAILY_QUOTA=50000
RELAY_MAX_BODY_BYTES=262144
RELAY_VERIFY_TTL_SECONDS=86400
